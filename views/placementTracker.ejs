<!DOCTYPE html>
<html>
  <head>
    <title>Placement Tracker | PlacementPro</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  </head>

  <body
    style="
      margin: 0;
      background: #000;
      color: #fff;
      font-family: 'Inter', sans-serif;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    "
  >
    <!-- NAVBAR -->
    <div
      style="
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 60px;
        border-bottom: 1px solid #111;
      "
    >
      <a href="/dashboard" style="text-decoration: none; color: #fff;">
        <h2 style="margin: 0; font-weight: 600;">PlacementPro</h2>
      </a>

      <div>
        <span style="margin-right: 20px; color: #aaa;">Welcome, <%= username %></span>
        <a
          href="/auth/logout"
          style="
            text-decoration: none;
            padding: 8px 18px;
            border-radius: 20px;
            border: 1px solid #333;
            color: #fff;
            font-size: 14px;
          "
          onmouseover="this.style.border='1px solid #fff'"
          onmouseout="this.style.border='1px solid #333'"
        >
          Logout
        </a>
      </div>
    </div>

    <!-- MAIN CONTENT -->
    <div style="flex: 1; padding: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; gap: 20px;">
        <div>
          <h1 style="font-weight: 600; margin-bottom: 10px;">Placement Tracker</h1>
          <p style="color: #777;">Track job applications stage-by-stage with timestamps.</p>
        </div>
      </div>

      <!-- FILTERS -->
      <div style="background: #0a0a0a; padding: 20px; border-radius: 15px; border: 1px solid #111; margin-bottom: 25px;">
        <form method="GET" action="/documents/placement-tracker" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center;">
          <label style="color:#888; font-size:14px;">Filter:</label>
          <select
            name="status"
            style="
              background:#000;
              color:#fff;
              border:1px solid #333;
              padding:10px 12px;
              border-radius:10px;
              outline:none;
            "
            onchange="this.form.submit()"
          >
            <option value="all" <%= filterStatus === 'all' ? 'selected' : '' %>>All</option>
            <option value="active" <%= filterStatus === 'active' ? 'selected' : '' %>>Active (Not Rejected)</option>
            <option value="rejected" <%= filterStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
            <option value="offerReceived" <%= filterStatus === 'offerReceived' ? 'selected' : '' %>>Offer Received</option>
          </select>
          <noscript>
            <button type="submit" style="background:#fff; color:#000; border:none; padding:10px 16px; border-radius:12px; font-weight:600; cursor:pointer;">Apply</button>
          </noscript>
        </form>
      </div>

      <!-- LAYOUT -->
      <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 25px;">

        <!-- COMPANY LIST -->
        <div>
          <h3 style="margin-top: 0; margin-bottom: 15px; font-weight: 600;">Your Companies</h3>

          <% if (!applications || applications.length === 0) { %>
            <div style="background:#0a0a0a; padding: 30px; border-radius: 15px; border:1px solid #111; color:#777; text-align:center;">
              No applications yet. Add one from the form on the right.
            </div>
          <% } else { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
              <% applications.forEach(app => { %>
                <% const statusKey = app.status; %>
                <div
                  style="
                    background:#0a0a0a;
                    padding: 20px;
                    border-radius: 15px;
                    border:1px solid #111;
                    transition:0.3s;
                  "
                >
                  <div style="display:flex; justify-content: space-between; gap:12px; align-items:flex-start;">
                    <div>
                      <h4 style="margin:0; word-break: break-word;"><%= app.companyName %></h4>

                      <% if (app.role) { %>
                        <p style="color:#888; margin: 6px 0 0; font-size: 13px; word-break: break-word;">Role: <%= app.role %></p>
                      <% } %>
                    </div>
                    <div style="text-align:right;">
                      <div style="color:#fff; font-weight:700; font-size:13px;">Current</div>
                      <div style="color:#bbb; font-size:13px; margin-top:4px;">
                        <%= stageLabelMap[statusKey] || statusKey %>
                      </div>
                    </div>
                  </div>

                  <!-- PROGRESS INDICATOR -->
                  <div style="margin-top: 15px;">
                    <div style="display: flex; flex-direction: column; gap: 10px;">
                      <% stageOrder.forEach(stageKey => { %>
                        <% const stageData = app.stages && app.stages.get ? app.stages.get(stageKey) : app.stages && app.stages[stageKey]; %>
                        <% const hasDate = stageData && stageData.statusDate; %>
                        <% const isDone = hasDate || (stageKey === app.status); %>
                  <div style="display:flex; justify-content: space-between; gap: 10px; align-items:center;">
                          <div style="display:flex; gap: 10px; align-items:center;">

                            <div
                              style="
                                width: 10px;
                                height: 10px;
                                border-radius: 50%;
                                background: <%= isDone ? '#fff' : '#333' %>;
                                box-shadow: <%= isDone ? '0 0 0 3px rgba(255,255,255,0.08)' : 'none' %>;
                              "
                            ></div>
                            <div style="color:#ddd; font-size:13px;">
                              <%= stageLabelMap[stageKey] %>
                            </div>
                          </div>
                          <div style="color:#777; font-size:12px;">
                            <%= hasDate ? new Date(stageData.statusDate).toLocaleDateString() : '' %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>

                </div>
              <% }) %>
            </div>
          <% } %>
        </div>

        <!-- STATUS UPDATE -->
        <div>
          <h3 style="margin-top: 0; margin-bottom: 15px; font-weight: 600;">Update Status</h3>

          <div style="background:#0a0a0a; padding: 20px; border-radius: 15px; border:1px solid #111;">
            <form method="POST" action="/documents/placement-tracker/update-status" style="display:flex; flex-direction:column; gap: 12px;">
              <label style="color:#888; font-size:14px;">Company</label>
              <input
                type="text"
                name="companyName"
                placeholder="e.g., Amazon"
                style="background:#000; color:#fff; border:1px solid #333; padding:12px; border-radius:10px; outline:none;"
                required
              />

              <label style="color:#888; font-size:14px;">Role (optional)</label>
              <input
                type="text"
                name="role"
                placeholder="e.g., Software Engineer"
                style="background:#000; color:#fff; border:1px solid #333; padding:12px; border-radius:10px; outline:none;"
              />

              <label style="color:#888; font-size:14px;">Stage</label>
              <select
                name="stageKey"
                style="background:#000; color:#fff; border:1px solid #333; padding:12px; border-radius:10px; outline:none;"
                required
              >
                <% stageOrder.forEach(stageKey => { %>
                  <option value="<%= stageKey %>"><%= stageLabelMap[stageKey] %></option>
                <% }) %>
              </select>

              <label style="color:#888; font-size:14px;">Date (optional)</label>
              <input
                type="date"
                name="statusDate"
                style="background:#000; color:#fff; border:1px solid #333; padding:12px; border-radius:10px; outline:none;"
              />

              <button
                type="submit"
                style="
                  margin-top: 8px;
                  background:#fff;
                  color:#000;
                  border:none;
                  padding:12px 16px;
                  border-radius:12px;
                  font-weight:700;
                  cursor:pointer;
                "
                onmouseover="this.style.opacity='0.85'"
                onmouseout="this.style.opacity='1'"
              >
                Save / Update
              </button>
            </form>

            <% if (error) { %>
              <div style="margin-top: 12px; color:#ff6b6b; font-size:13px;">
                <%= error %>
              </div>
            <% } %>

            <% if (success) { %>
              <div style="margin-top: 12px; color:#7CFFB2; font-size:13px;">
                <%= success %>
              </div>
            <% } %>
          </div>

          <div style="margin-top: 20px;">
            <h4 style="margin: 0 0 10px; font-weight: 600;">Delete Application</h4>
            <div style="background:#0a0a0a; padding: 18px; border-radius: 15px; border:1px solid #111;">
              <form method="POST" action="/documents/placement-tracker/delete-application" style="display:flex; flex-direction:column; gap: 10px;">
                <label style="color:#888; font-size:14px;">Company</label>
                <select
                  name="companyId"
                  style="background:#000; color:#fff; border:1px solid #333; padding:12px; border-radius:10px; outline:none;"
                  required
                >
                  <option value="" selected disabled>Select a company</option>
                  <% if (applications && applications.length) { %>
                    <% applications.forEach(app => { %>
                      <option value="<%= app.companyId %>"><%= app.companyName %></option>
                    <% }) %>
                  <% } %>
                </select>

                <button
                  type="submit"
                  style="
                    background:none;
                    border:1px solid #ff4d4d;
                    color:#ff4d4d;
                    padding:12px 16px;
                    border-radius:12px;
                    font-weight:700;
                    cursor:pointer;
                  "
                  onmouseover="this.style.background='#ff4d4d1a'"
                  onmouseout="this.style.background='transparent'"
                >
                  Delete
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTER -->
    <div style="padding: 20px; text-align: center; border-top: 1px solid #111; color: #555; font-size: 13px;">
      © <%= new Date().getFullYear() %> PlacementPro. Built for smarter placements.
    </div>
  </body>
</html>

